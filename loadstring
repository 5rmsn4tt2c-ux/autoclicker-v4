script_key = "KEY-HERE"

local repo = "5rmsn4tt2c-ux/autoclicker-v4"
local httpRequest = http_request or request or (http and http.request) or (syn and syn.request)

if not httpRequest then
	return warn("[Autoclicker] Your executor has no 'request' function.")
end

local function ghGet(url)
	local res = httpRequest({
		Url = url,
		Method = "GET",
		Headers = { ["User-Agent"] = "Autoclicker" }
	})
	return res.Body or res.body, res.StatusCode or res.status_code or 0
end

if not getgenv().__repoAuth then
	if hookmetamethod and getnamecallmethod and newcclosure then
		getgenv().__repoAuth = true
		local old
		old = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
			if getnamecallmethod() == "HttpGet" then
				local url = ...
				if type(url) == "string" and url:find(repo, 1, true) then
					local body, code = ghGet(url)
					if code >= 200 and code < 300 then return body end
				end
			end
			return old(self, ...)
		end))
	else
		warn("[Autoclicker] Executor missing hookmetamethod/newcclosure - GitHub fetch may fail.")
	end
end

local body, code = ghGet("https://raw.githubusercontent.com/" .. repo .. "/main/init.lua?t=" .. tostring(tick()))
if code == 200 then
	loadstring(body, "init.lua")({})
else
	warn("[Autoclicker] init.lua failed (HTTP " .. code .. ").")
end
